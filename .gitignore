# dependencies
node_modules
.pnp
.pnp.js

# build output
dist
dist-ssr
*.local

# environment — never commit keys
.env
.env.local
.env.*.local

# claude code — personal, machine-specific settings
.claude/settings.local.json

# editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# supabase local
supabase/.temp
supabase/.branches

# source artwork kept beside the project, not part of the build
# The originals of the announcement covers. What the app serves are the
# copies uploaded to Supabase Storage, which announcements.cover_path points
# at; these are the files they were made from.
announcement-covers/

# OCR runtime, copied out of node_modules by scripts/sync-ocr-assets.mjs.
# ~13 MB of binaries, reproducible with `npm run ocr:assets`, so they are
# served by the app but not kept in git.
public/ocr/
